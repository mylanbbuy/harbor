# Copy this file to .env.local and fill in your real Supabase values.
# Find these in your Supabase project: Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The WhatsApp number for general contact (Contact page only — checkout no longer uses WhatsApp).
# Format: country code + number, no + or spaces. Example Tanzania number: 255712345678
NEXT_PUBLIC_WHATSAPP_NUMBER=255700000000
NEXT_PUBLIC_CONTACT_EMAIL=info@harbor.co.tz
NEXT_PUBLIC_CONTACT_PHONE=+255 700 000 000

# --- SERVER-ONLY SECRETS (never prefix these with NEXT_PUBLIC_) ---

# Supabase Service Role key — Settings -> API -> service_role.
# Used only in server-side API routes (checkout, webhook) to safely
# update orders/stock. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Selcom API Gateway credentials — request access from Selcom's business
# team (info@selcom.net) to get these. See supabase README for setup notes.
SELCOM_API_KEY=your-selcom-api-key
SELCOM_API_SECRET=your-selcom-api-secret
SELCOM_VENDOR_ID=your-selcom-vendor-id
SELCOM_BASE_URL=https://apigw.selcommobile.com
SELCOM_BASE_URL_SANDBOX=https://apigwtest.selcommobile.com

# Set to "true" while testing against Selcom's sandbox, "false" once live.
SELCOM_USE_SANDBOX=true

# Your deployed site URL, used for Selcom redirect/cancel/webhook URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.co.tz
